# ── Adobe PDF Services (PDF <-> Word / Excel / PowerPoint) ──────────────────
# Credentials from https://acrobatservices.adobe.com/dc-integration-creation-app-cdn/main.html
PDF_SERVICES_CLIENT_ID=
PDF_SERVICES_CLIENT_SECRET=
# Optional: "ew1" to process files in the EU region (default: US)
PDF_SERVICES_REGION=
# Optional: global monthly cap on successful conversions (default 450; Adobe free tier = 500 transactions/month).
# Enforced only when KV (Redis) is configured below.
ADOBE_MONTHLY_LIMIT=
# Optional: conversions per IP per 24h, shared across the 6 Adobe tools (default 10)
ADOBE_PER_IP_DAILY=
# TEST ONLY: point the Adobe client at a local mock server. Never set in production.
PDF_SERVICES_BASE_URL=

# ── Upstash Redis (Vercel Marketplace integration sets these) ───────────────
# Optional: shared per-IP rate limits across serverless instances + the global monthly counter.
# Without them, per-IP limits are per-instance in-memory and there is no global cap.
KV_REST_API_URL=
KV_REST_API_TOKEN=
